split_window_vertically
other_window
split_window_horizontally
delete_window
other_window
delete_other_window
switch_to_buffer "*Messages*"
revert_buffer
all_text = @frame.view_win.sci_get_text(@frame.view_win.sci_get_length + 1)
File.open(ENV['MRBMACS_BINTEST_OUT'] || '/dev/stderr', 'w') do |f|
  all_text.each_line do |line|
    f.puts line if line =~ / ERROR /
  end
end
@frame.exit
exit
